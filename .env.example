# Property Pulse - Environment Variables

# Supabase (get from your Supabase project dashboard)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# OpenAI (for Edge Functions - set in Supabase dashboard after deploy)
# OPENAI_API_KEY=sk-...

# After creating your Supabase project:
# 1. Go to Settings > API
# 2. Copy the URL and anon key to frontend .env
# 3. Deploy Edge Functions with: supabase functions deploy agent --no-verify-jwt
# 4. Set secrets: supabase secrets set OPENAI_API_KEY=your-key
